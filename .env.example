# Local (docker compose up -d). Em produção: connection string do Supabase (session pooler, IPv4).
DATABASE_URL=postgres://leilao:leilao@localhost:5433/leilao
# true em produção (Supabase exige TLS)
DATABASE_SSL=false
# Gere um valor aleatório longo: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=troque-este-valor
PORT=3000
NODE_ENV=development
