# Local (docker compose up -d). Em produção: connection string do Supabase (session pooler, IPv4).
DATABASE_URL=postgres://leilao:leilao@localhost:5433/leilao
# Banco SEPARADO para a âncora de auditoria (em produção: outro provedor, ex.: Neon; usuário só com INSERT/SELECT, ver api/scripts/anchor-role.ts)
ANCHOR_DATABASE_URL=postgres://leilao:leilao@localhost:5433/anchor
# true em produção (Supabase exige TLS)
DATABASE_SSL=false
# Gere um valor aleatório longo: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=troque-este-valor
PORT=3000
NODE_ENV=development
# Tempo real (Supabase Realtime Broadcast). Opcional: sem eles o front consulta a API a cada 3 s.
# Servidor: Project URL e Secret key (nunca expor no navegador)
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# Navegador (embutidos no build do Vite): Project URL e Publishable key
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=